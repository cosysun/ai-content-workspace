# Gemini API Key (通用，用于内容/语音/生图)
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek API Key (内容生成)
# Get your API key from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 豆包 API Key (语音生成/生图)
# Get your API key from: https://console.volcengine.com/ark
DOUBAO_API_KEY=your_doubao_api_key_here
DOUBAO_APP_ID=your_doubao_app_id_here

# ElevenLabs API Key (音效生成)
# Get your API key from: https://elevenlabs.io/app/sound-generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

